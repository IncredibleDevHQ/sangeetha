{
  "name": "sangeetha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.api.json && vite build",
    "start": "node dist/server/main.js",
    "check": "tsc --noEmit",
