    "db:migrate": "tsx scripts/migrate.ts",
    "provision": "tsx scripts/provision.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vite": "^6.4.1",
