# Local simulator: no Google sign-in or SMS is delivered.
AUTH_MODE=local
LOCAL_SEED=1
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Optional locally; mandatory in production.
# DATABASE_URL=postgres://sangeetha:password@127.0.0.1:5432/sangeetha
# Production: AUTH_MODE=oidc, NODE_ENV=production, HTTPS PUBLIC_ORIGIN
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_GOOGLE_IDP_ID=

# Optional multi-school local testing:
# PUBLIC_ORIGIN=http://localhost:5173
# TENANT_ROOT_DOMAIN=localhost
# Open http://sangeetha-music-school.localhost:5173

# Private media: persistent filesystem OR private S3, never a public bucket.
# MEDIA_STORAGE=filesystem
# MEDIA_PATH=/srv/sangeetha/private-media
# MEDIA_S3_BUCKET=
# AWS_REGION=ap-south-1
# SCHOOL_MEDIA_QUOTA_BYTES=1073741824

# Server-only provider credentials; multi-school maps are preferable.
# WHATSAPP_GRAPH_VERSION=use-your-supported-provider-version
# WHATSAPP_TOKEN=
# WHATSAPP_TOKENS_JSON={"sender-phone-id":"token"}
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# RAZORPAY_KEYS_JSON={"school-uuid":{"keyId":"","secret":"","webhookSecret":""}}
# Single-provider-account deployments may instead set the three values below.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
