# Local simulator: no Google sign-in or SMS is delivered.
AUTH_MODE=local
LOCAL_SEED=1
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Optional locally; mandatory in production.
# DATABASE_URL=postgres://sangeetha:password@127.0.0.1:5432/sangeetha
# Production: AUTH_MODE=oidc, NODE_ENV=production, HTTPS PUBLIC_ORIGIN
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_GOOGLE_IDP_ID=

# Optional multi-school local testing:
# PUBLIC_ORIGIN=http://localhost:5173
# TENANT_ROOT_DOMAIN=localhost
# Open http://sangeetha-music-school.localhost:5173
